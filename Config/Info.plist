<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只放無法用 INFOPLIST_KEY_* 建置設定產生的 key；其餘由 Xcode 自動產生後合併進來。
	     這個檔案刻意放在 PhotoSweep/ 資料夾外，避免被當成資源複製進 App。 -->
	<!-- 「僅限所選照片」時，不要讓 iOS 每次啟動都跳出「選取更多照片」詢問；App 內有自己的按鈕 -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<!-- 沒有使用需要申報的加密：上傳 App Store Connect 時不必每次回答出口合規問題 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
